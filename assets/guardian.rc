#pragma code_page(65001)

1 ICON "guardian.ico"
1 24 "guardian.manifest"

1 VERSIONINFO
 FILEVERSION GUARDIAN_VERSION_PARTS
 PRODUCTVERSION GUARDIAN_VERSION_PARTS
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "校园网守护\0"
            VALUE "FileVersion", GUARDIAN_FILE_VERSION
            VALUE "InternalName", "campus-network-guardian\0"
            VALUE "OriginalFilename", "campus-network-guardian.exe\0"
            VALUE "ProductName", "校园网守护\0"
            VALUE "ProductVersion", GUARDIAN_PRODUCT_VERSION
            VALUE "CompanyName", "Liunian520\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Liunian520 and contributors\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
